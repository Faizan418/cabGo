# Server Configuration
PORT=4000

# MongoDB Database URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/cab-service

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Google Maps API Key
GOOGLE_MAPS_API=your_google_maps_api_key_here

# Email Delivery Configuration (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password
EMAIL_FROM="CabGo Security" <no-reply@cabgo.app>
